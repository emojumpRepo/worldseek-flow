# 数据库连接池配置 - 增加连接池大小解决 QueuePool 错误
LANGFLOW_DB_CONNECTION_SETTINGS={"pool_size": 50, "max_overflow": 100, "pool_timeout": 60, "pool_pre_ping": true, "pool_recycle": 1800, "echo": false}

# 数据库连接超时设置
LANGFLOW_DB_CONNECT_TIMEOUT=60

# 启用数据库连接重试
LANGFLOW_DATABASE_CONNECTION_RETRY=true

# 如果要切换到 PostgreSQL，取消注释并修改下面的配置
# LANGFLOW_DATABASE_URL=postgresql://user:password@localhost:5432/langflow_db 