# Langflow清洁启动环境变量配置
# 用于减少启动时的警告和信息输出

# Python 警告控制
PYTHONWARNINGS=ignore::UserWarning,ignore::DeprecationWarning,ignore::SyntaxWarning

# SQLAlchemy 配置
SQLALCHEMY_WARN_20=0
SQLALCHEMY_SILENCE_UBER_WARNING=1

# Gunicorn 日志级别
GUNICORN_CMD_ARGS="--log-level warning --access-logfile - --error-logfile -"

# LangChain 配置
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=""

# Langflow 日志级别
LANGFLOW_LOG_LEVEL=INFO

# 抑制特定的第三方警告
PYTHONDONTWRITEBYTECODE=1

# 数据库迁移时抑制警告
ALEMBIC_WARN_ON_MISSING_REVISION=false

# 开发环境设置（可选）
# LANGFLOW_DEV=false

# 生产环境优化（推荐）
LANGFLOW_CACHE_TYPE=simple
LANGFLOW_WORKERS=1 