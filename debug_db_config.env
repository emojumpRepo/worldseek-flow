# 调试数据库连接问题的配置
LANGFLOW_DB_CONNECTION_SETTINGS={"pool_size": 50, "max_overflow": 100, "pool_timeout": 60, "pool_pre_ping": true, "pool_recycle": 1800, "echo": true, "echo_pool": true}

# 启用详细日志
LANGFLOW_LOG_LEVEL=DEBUG

# 数据库连接重试
LANGFLOW_DATABASE_CONNECTION_RETRY=true
LANGFLOW_DB_CONNECT_TIMEOUT=60

# 如果使用 SQLite，添加 WAL 模式优化
LANGFLOW_SQLITE_PRAGMAS={"synchronous": "NORMAL", "journal_mode": "WAL", "cache_size": 10000, "temp_store": "memory"}

# 监控连接池状态的提示:
# 添加 echo=true 和 echo_pool=true 可以在日志中看到：
# - SQL 查询执行情况
# - 连接池的获取和释放
# - 帮助识别连接泄漏的位置 